{
  "name": "isomorphic",
  "version": "7.0.0",
  "description": "A nextjs template to build dashboard",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "lint": "turbo lint",
    "build": "turbo build",
    "start": "turbo start",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "iso:dev": "turbo dev --filter=isomorphic",
    "iso:lint": "turbo lint --filter=isomorphic",
    "iso:build": "turbo build --filter=isomorphic",
    "iso:start": "turbo start --filter=isomorphic",
    "iso:clean": "turbo clean --filter=isomorphic",
    "starter:dev": "turbo dev --filter=starter",
    "starter:lint": "turbo lint --filter=starter",
    "starter:build": "turbo build --filter=starter",
    "starter:start": "turbo start --filter=starter",
    "starter:clean": "turbo clean --filter=starter",
    "i18n:dev": "turbo dev --filter=i18n",
    "i18n:lint": "turbo lint --filter=i18n",
    "i18n:build": "turbo build --filter=i18n",
    "i18n:start": "turbo start --filter=i18n",
    "i18n:clean": "turbo clean --filter=i18n"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "rimraf": "^5.0.5",
    "turbo": "2.9.14"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@3": "3.0.6",
      "minimatch@3": "3.1.4",
      "minimatch@9": "9.0.7",
      "nanoid@3": "3.3.17",
      "js-yaml": "4.3.1",
      "ip-address": "10.3.1",
      "socket.io-parser": "4.2.7",
      "basic-ftp": "5.3.1",
      "flatted": "3.4.2",
      "ws": "8.21.0",
      "serialize-javascript": "7.0.5",
      "picomatch": "2.3.2",
      "next": "15.5.23",
      "mongoose": "8.24.3",
      "@headlessui/react": "2.2.10",
      "braces": "3.0.3",
      "fast-loops": "1.1.4",
      "cross-spawn": "7.0.5",
      "glob@10": "10.5.0",
      "h3": "1.15.9",
      "effect": "3.20.0",
      "lodash-es": "4.18.1",
      "defu": "6.1.5",
      "js-cookie": "3.0.7",
      "tmp": "0.2.7",
      "nodemailer": "9.0.5",
      "engine.io": "6.6.7",
      "postcss": "8.5.26",
      "sharp": "0.35.3",
      "micromatch": "4.0.8",
      "webpack": "5.104.1",
      "esbuild": "0.25.12",
      "@babel/runtime": "7.26.10",
      "@babel/runtime-corejs3": "7.26.10",
      "@babel/helpers": "7.26.10",
      "@babel/core": "7.29.6",
      "prismjs": "1.30.0",
      "ajv@6": "6.14.0",
      "qs": "6.15.2",
      "yaml@1": "1.10.3",
      "yaml@2": "2.8.3",
      "uuid": "11.1.1",
      "protocol-buffers-schema": "3.6.1",
      "cookie@0.4": "0.7.2",
      "diff": "4.0.4",
      "vite": "6.4.3"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "nodemailer": "9"
      }
    }
  },
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18"
  }
}
